{
  "name": "dsh-exv-flat-corners",
  "version": "2.3.1",
  "type": "module",
  "description": "Removes every corner radius from the DSH Web interface.",
  "license": "MIT",
  "author": "VMW_HW",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "square-corners"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VMWHW/dsh-exv-theme.git"
  },
  "homepage": "https://github.com/VMWHW/dsh-exv-theme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
